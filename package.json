{
  "name": "ironfront-command",
  "version": "0.2.6",
  "description": "Desktop multiplayer prototype with four factions",
  "main": "electron/main.cjs",
  "author": "Ironfront Studio",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "release:win": "npm run build && electron-builder --win nsis --publish always",
    "start": "electron ."
  },
  "build": {
    "appId": "com.ironfront.command",
    "productName": "Ironfront Command",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "publish": [{ "provider": "github", "owner": "Pyxellator", "repo": "ironfront-update", "releaseType": "release" }],
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Ironfront Command" }
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "firebase": "latest",
    "three": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
